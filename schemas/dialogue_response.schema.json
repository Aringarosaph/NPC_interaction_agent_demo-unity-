{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue_response.agent",
  "title": "Agent Dialogue Response",
  "type": "object",
  "required": [
    "schema_version",
    "turn_id",
    "npc_id",
    "utterances",
    "world_events",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "const": "dialogue_response.agent"
    },
    "turn_id": {
      "type": "string"
    },
    "npc_id": {
      "type": "string"
    },
    "utterances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "text",
          "expression",
          "action",
          "delay_ms"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "expression": {
            "enum": [
              "neutral",
              "soft_smile",
              "amused",
              "teasing",
              "concerned",
              "stern"
            ]
          },
          "action": {
            "enum": [
              "idle",
              "nod",
              "soft_laugh",
              "thoughtful",
              "dismissive",
              "hand_on_chest"
            ]
          },
          "delay_ms": {
            "type": "integer"
          }
        }
      }
    },
    "world_events": {
      "type": "array"
    },
    "trace": {
      "type": "object",
      "required": [
        "used_knowledge_ids",
        "used_memory_ids",
        "tool_calls",
        "tool_results",
        "memory_candidates",
        "confidence"
      ],
      "properties": {
        "used_knowledge_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used_memory_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan": {
          "type": ["object", "null"]
        },
        "tool_calls": {
          "type": "array"
        },
        "tool_results": {
          "type": "array"
        },
        "memory_candidates": {
          "type": "array"
        },
        "reflection": {
          "type": ["object", "null"]
        },
        "confidence": {
          "type": "number"
        }
      }
    }
  }
}
